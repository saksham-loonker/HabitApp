{
  "name": "UserPreferences",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "dark_mode": {
      "type": "boolean",
      "default": false
    },
    "default_view": {
      "type": "string",
      "enum": [
        "dashboard",
        "calendar",
        "kanban",
        "tasks"
      ],
      "default": "dashboard"
    },
    "notification_enabled": {
      "type": "boolean",
      "default": true
    },
    "reminder_default_minutes": {
      "type": "number",
      "default": 30
    },
    "work_hours_start": {
      "type": "string",
      "default": "09:00"
    },
    "work_hours_end": {
      "type": "string",
      "default": "17:00"
    },
    "active_widgets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kanban_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pomodoro_work_minutes": {
      "type": "number",
      "default": 25
    },
    "pomodoro_break_minutes": {
      "type": "number",
      "default": 5
    }
  },
  "required": [
    "user_email"
  ]
}